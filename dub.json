{
	"authors": [
		"Rojetto",
        "qwertfisch"
	],
	"description": "Neo-Tastaturlayouts für Windows",
	"libs": [
		"user32", "gdi32", "shell32"
	],
    "sourceFiles": ["res\\ananeo.res"],
	"license": "GPL-3.0",
    "name": "ananeo",
    "versions": ["Windows10"],
    "buildTypes": {
        "debug": {
            "buildOptions": ["debugMode", "debugInfo"],
            "buildRequirements": ["allowWarnings"]
        },
        "debug-log": {
            "buildOptions": ["debugMode", "debugInfo"],
            "buildRequirements": ["allowWarnings"],
            "versions": ["FileLogging"]
        },
        "release": {
            "lflags": ["/SUBSYSTEM:windows", "/ENTRY:mainCRTStartup"]
        }
    },
    "libs-windows-x86_64": ["lib/x86_64/cairo"],
    "copyFiles-windows-x86_64": ["lib/x86_64/*.dll"],
    "configurations": [
        {
            "name": "application",
            "targetType": "executable",
            "excludedSourceFiles": ["source/test_main.d", "source/tool_main.d"]
        },
        {
            "name": "unittest",
            "targetType": "executable",
            "targetName": "ananeo-test",
            "mainSourceFile": "source/test_main.d",
            "excludedSourceFiles": ["source/tool_main.d"]
        },
        {
            "name": "tool",
            "targetType": "executable",
            "targetName": "ananeo-tool",
            "mainSourceFile": "source/tool_main.d",
            "excludedSourceFiles": [
                "source/test_main.d",
                "source/app.d",
                "source/ananeo.d",
                "source/osk.d",
                "source/fontchain.d",
                "source/trayicon.d",
                "source/localization.d",
                "source/cairo/cairo.d",
                "source/cairo/cairo_win32.d"
            ]
        }
    ]
}